# PostgreSQL connection used by the panel and migrations.
DATABASE_URL=postgres://vpnpanel:change-me@127.0.0.1:5432/vpn_panel

HOST=127.0.0.1
PORT=3129
VPN_PANEL_PUBLIC_BASE_URL=http://127.0.0.1:3129
VPN_PANEL_SECURE_CONFIG=./config/secure.json

# Set these in your secret store or local .env; do not commit real values.
# VPN_PANEL_SESSION_SECRET=generate-a-long-random-value
# VPN_PANEL_ADMIN_LOGIN=admin
# VPN_PANEL_ADMIN_PASSWORD=change-me-before-first-login
# VPN_PANEL_HEALTH_API_KEY=generate-a-separate-health-key
